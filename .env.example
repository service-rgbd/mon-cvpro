# Paystack — clés depuis https://dashboard.paystack.com/#/settings/developers
# Copiez ce fichier en .env.local à la racine du projet

# Clé secrète (sk_test_... ou sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Alias accepté :
# PAYSTACK_LIVE_KEY=sk_test_xxx

# Clé publique (pk_test_... ou pk_live_...) — requise pour le popup de paiement
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# --- Local ---
APP_URL=http://localhost:22723
# DATABASE_URL=postgresql://... (Neon) — optionnel en local ; sinon memory:// via pnpm dev:api

# --- Production ---
# Frontend (Cloudflare Worker) : https://mon-cvpro.binary-security.com
# API (Render)               : https://ci-cv.binary-security.com
#
# Render (api-server) :
#   NODE_ENV=production
#   DATABASE_URL=<connection string Neon — avec ?sslmode=require>
#   PAYSTACK_SECRET_KEY=sk_...
#   PAYSTACK_PUBLIC_KEY=pk_...
#   APP_URL=https://mon-cvpro.binary-security.com
#   CORS_ORIGINS=https://mon-cvpro.binary-security.com (optionnel si = APP_URL)
#   SESSION_SECRET=<chaîne aléatoire>
#
# Neon : créer les tables une fois :
#   pnpm run db:push
#
# Déploiement backend Render (sans Docker) — ajoutez dans env.local :
#   RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-...?key=...
# puis : pnpm run deploy:api
#
# Cloudflare Worker (build) :
#   pnpm --filter @workspace/cv-builder run build:prod
#   pnpm --filter @workspace/cv-builder run deploy
#   (ou CI : VITE_API_BASE_URL=https://ci-cv.binary-security.com)
#
# Paystack webhook : https://ci-cv.binary-security.com/api/webhooks/paystack
