# Collez ces clés dans Render → mon-cv-pro-api → Environment
# (ne commitez pas les vraies valeurs)

NODE_ENV=production
APP_URL=https://mon-cvpro.binary-security.com
# OBLIGATOIRE — sans cela l'API crash au démarrage (voir logs Render)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PAYSTACK_SECRET_KEY=<sk_test_ ou sk_live_>
PAYSTACK_PUBLIC_KEY=<pk_test_ ou pk_live_>
SESSION_SECRET=<générer une chaîne aléatoire de 32+ caractères>

# Runtime : Node (pas Docker)
# Build  : corepack + pnpm install + pnpm --filter @workspace/api-server run build
# Start  : pnpm --filter @workspace/api-server run start
# Health : /api/healthz
# Domaine custom : ci-cv.binary-security.com
